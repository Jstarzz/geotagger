# syntax=docker/dockerfile:1.7

ARG CLICKHOUSE_VERSION=26.8.2.7
ARG CLICKHOUSE_MINOR=26.8

FROM alpine:3.22 AS compat
ARG CLICKHOUSE_VERSION
ARG CLICKHOUSE_MINOR
RUN apk add --no-cache ca-certificates curl
RUN curl --fail --location --retry 3 \
      "https://builds.clickhouse.com/${CLICKHOUSE_MINOR}/amd64compat/clickhouse" \
      --output /clickhouse \
    && chmod 0755 /clickhouse \
    && /clickhouse --version | tee /tmp/clickhouse-version \
    && grep -F "${CLICKHOUSE_VERSION}" /tmp/clickhouse-version \
    && sha256sum /clickhouse

FROM clickhouse/clickhouse-server:${CLICKHOUSE_VERSION}-alpine
ARG CLICKHOUSE_VERSION
COPY --from=compat --chmod=0755 /clickhouse /usr/bin/clickhouse
RUN clickhouse --version | tee /tmp/clickhouse-version \
    && grep -F "${CLICKHOUSE_VERSION}" /tmp/clickhouse-version \
    && rm -f /tmp/clickhouse-version
